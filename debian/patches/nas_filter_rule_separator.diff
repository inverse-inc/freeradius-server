Description: NAS-Filter-Rule: preserve the 0x00 rule separator across the
 253-byte attribute boundary so a downstream FreeRADIUS does not merge the
 last two rules.  Keeps whole-rule-per-attribute packing (equipment compat).
 Also fixes an out-of-bounds read in the decoder return value, and updates
 the rfc4849 unit-test vectors to match.
Author: Durand Fabrice
---
diff --git a/src/lib/radius.c b/src/lib/radius.c
index 9e25f79abb..124e4b77af 100644
--- a/src/lib/radius.c
+++ b/src/lib/radius.c
@@ -1691,7 +1691,14 @@ int rad_vp2rfc(RADIUS_PACKET const *packet,
 				attr[0] = PW_NAS_FILTER_RULE;
 				attr[1] = 2;
 				p = attr + 2;
-				zero = false;
+				/*
+				 *	Do NOT reset "zero" here.  A
+				 *	separator is still pending between
+				 *	the previous rule and this one; it
+				 *	must be written as the first byte
+				 *	of the new attribute so the decoder
+				 *	doesn't merge the two rules.
+				 */
 			}
 
 			if (zero) {
@@ -3290,7 +3297,7 @@ static ssize_t data2vp_nas_filter_rule(TALLOC_CTX *ctx,
 		attr = attr_end;
 	}
 
-	if (q == buffer) return attr + attr[2] - start;
+	if (q == buffer) return attr - start;
 
 	vp = fr_pair_afrom_da(ctx, da);
 	if (!vp) {
diff --git a/src/tests/unit/rfc4849.txt b/src/tests/unit/rfc4849.txt
index 957a9e9579..465651d1b7 100644
--- a/src/tests/unit/rfc4849.txt
+++ b/src/tests/unit/rfc4849.txt
@@ -2,7 +2,9 @@
 #  RFC 4849 NAS-Filter-Rule
 #
 #  Individual rules are packed together as with EAP-Message,
-#  but the rules are separated by a 0x00 byte.
+#  but the rules are separated by a 0x00 byte.  Rules are never
+#  split across an attribute boundary; a pending separator is
+#  carried to the start of the next attribute.
 #
 encode NAS-Filter-Rule = "hello"
 data 5c 07 68 65 6c 6c 6f
@@ -24,19 +26,21 @@ decode -
 data NAS-Filter-Rule = "hello", NAS-Filter-Rule = "bob", NAS-Filter-Rule = "stuff"
 
 #
-#  And large amounts of data
+#  And large amounts of data.  Rules are kept whole (never split
