Description: NAS-Filter-Rule: write each rule with a trailing 0x00 separator
 to keep every wire attribute self-contained.  This is compatible with
 both RFC 4849 concatenation (used by Arista) and per-attribute parsers
 (used by FortiSwitch, which requires each NAS-Filter-Rule attribute to
 contain only complete rules).
 .
 In the pathological case of a rule >= 253 bytes the trailing separator
 does not fit; a pending separator is carried to the next attribute.
 .
 Also fixes an out-of-bounds read in the decoder return value, and
 updates the rfc4849 unit-test vectors to match the new encoding.
Author: Durand Fabrice
---
diff --git a/src/lib/radius.c b/src/lib/radius.c
index 9e25f79abb..46258079ff 100644
--- a/src/lib/radius.c
+++ b/src/lib/radius.c
@@ -1645,7 +1645,6 @@
 	if (vp->da->attr == PW_NAS_FILTER_RULE) {
 		uint8_t const *end = ptr + room;
 		uint8_t *p, *attr = ptr;
-		bool zero = false;
 		uint8_t rule_buffer[1024] = {0};
 		size_t rule_len = 0;
 		VALUE_PAIR *current = vp;
@@ -1668,6 +1667,8 @@
 		attr[1] = 2;
 		p = ptr + 2;
 
+		bool pending_sep = false;
+
 		size_t offset = 0;
 		while (offset < rule_len) {
 			size_t rule_start = offset;
@@ -1683,28 +1684,82 @@
 			}
 
 			size_t space_left = 255 - attr[1];
-			if (space_left < this_rule_len + (zero ? 1 : 0)) {
-				attr = p;
-				if ((attr + 2) >= end) {
-					break;				}
-
-				attr[0] = PW_NAS_FILTER_RULE;
-				attr[1] = 2;
-				p = attr + 2;
-				zero = false;
-			}
 
-			if (zero) {
-				*(p++) = 0;
-				attr[1]++;
+			/*
+			 *	Each rule is written with a trailing
+			 *	0x00 separator.  This keeps every wire
+			 *	attribute self-contained, which is
+			 *	compatible with both RFC 4849
+			 *	concatenation (Arista) and per-attribute
+			 *	parsers (FortiSwitch).
+			 */
+			size_t needed = this_rule_len + 1;
+
+			if (space_left < needed) {
+				/*
+				 *	Rule (with trailing \0) doesn't
+				 *	fit in the current attribute.
+				 */
+				if (attr[1] > 2) {
+					/*
+					 *	Attribute has content; start
+					 *	a new one so the rule stays
+					 *	whole.
+					 */
+					attr = p;
+					if ((attr + 2) >= end) {
+						break;
+					}
+
+					attr[0] = PW_NAS_FILTER_RULE;
+					attr[1] = 2;
+					p = attr + 2;
+
+					/*
+					 *	If a giant rule filled the
+					 *	previous attribute without
+					 *	a trailing \0, write the
+					 *	pending separator now.
+					 */
+					if (pending_sep) {
+						*(p++) = 0;
+						attr[1]++;
+						pending_sep = false;
+					}
+
+					space_left = 255 - attr[1];
+				}
+
+				/*
+				 *	Rule is >= 253 bytes — the
+				 *	trailing \0 genuinely doesn't
+				 *	fit even in a fresh attribute.
+				 *	Degrade: write without it.
+				 */
+				if (space_left < needed) {
+					needed = this_rule_len;
+				}
 			}
 
 			memcpy(p, rule_buffer + rule_start, this_rule_len);
 			p += this_rule_len;
 			attr[1] += this_rule_len;
 
+			/*
+			 *	Write the trailing \0 separator
+			 *	when there is room.  Otherwise flag
+			 *	a pending separator for the next
+			 *	attribute (giant rule edge case).
+			 */
+			if (needed > this_rule_len) {
+				*(p++) = 0;
+				attr[1]++;
+				pending_sep = false;
+			} else {
+				pending_sep = true;
+			}
+
 			offset = next_rule + 1;
-			zero = true;
 		}
 
 		*pvp = current;
